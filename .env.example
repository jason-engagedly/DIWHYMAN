# Copy this file to .env and fill in your keys. Never commit .env or share your keys.

# Claude analyzes the room photo. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI generates the "new color" preview image. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional settings
# PORT=3000
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_IMAGE_MODEL=gpt-image-2

# Pro access codes, comma-separated. Anyone with one of these codes can use the AI color
# preview. Stand-in until real accounts and payments are added. Example: PRO_ACCESS_CODES=FRIEND-2026,BETA-TESTER
PRO_ACCESS_CODES=
# Max color previews per Pro code per day (keeps image costs under control).
# PRO_DAILY_PREVIEW_LIMIT=20
